{
  "name": "claude-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Windows launcher that opens the Claude desktop app in isolated profiles, one account per profile.",
  "type": "module",
  "main": "src/main/main.js",
  "author": "histuan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.histuan.claude-launcher",
    "productName": "Multi-Account Launcher for Claude",
    "artifactName": "Claude-Launcher-Setup-${version}.${ext}",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "Multi-Account Launcher for Claude"
    }
  }
}
