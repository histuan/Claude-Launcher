{
  "name": "claude-multiconta",
  "version": "0.1.0",
  "private": true,
  "description": "Launcher para abrir o app desktop do Claude em perfis isolados, uma conta por perfil.",
  "type": "module",
  "main": "src/main/main.js",
  "author": "histuan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.histuan.multiconta",
    "productName": "Multiconta para Claude",
    "artifactName": "Multiconta-para-Claude-Setup-${version}.${ext}",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "Multiconta para Claude"
    }
  }
}
